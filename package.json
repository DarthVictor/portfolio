{
    "name": "astro",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": "24.x",
        "pnpm": "11.x"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
