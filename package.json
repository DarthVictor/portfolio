    },
    "packageManager": "pnpm@11.0.0",
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@biomejs/biome": "^2.5.6",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
