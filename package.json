{
    "name": "astro",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": "24.x",
        "pnpm": ">=10 <12"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "build:preview": "astro build --mode preview",
        "preview": "astro preview",
        "astro": "astro",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "test": "pnpm test:unit",
        "test:output": "node --test tests/output.production.test.mjs",
        "test:output:preview": "pnpm build:preview && node --test tests/output.preview.test.mjs",
        "test:output:production": "pnpm build && pnpm test:output",
        "test:unit": "vitest run",
        "verify": "pnpm format:check && pnpm lint && pnpm test:unit && pnpm test:output:production && pnpm test:output:preview && pnpm build",
        "cv:pdf": "node scripts/generate-cv-pdf.mjs"
    },
    "dependencies": {
        "@astrojs/mdx": "^7.0.5",
        "@astrojs/preact": "^6.0.2",
        "astro": "^7.1.5",
        "preact": "^10.29.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "marked": "^18.0.7",
        "playwright": "^1.62.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
