---
interface Props {
    index: string;
    headingId: string;
    title: string;
    description?: string;
    class?: string;
}

const {
    index,
    headingId,
    title,
    description,
    class: className,
} = Astro.props;
---

<section
    class:list={["content-section", className]}
    aria-labelledby={headingId}
>
    <div class="section-heading">
        <p class="section-index type-label">{index}</p>
        <h2 id={headingId}>{title}</h2>
        {description && <p>{description}</p>}
    </div>

    <slot />
</section>

<style>
    .content-section {
        display: grid;
        grid-template-columns: minmax(11rem, 0.38fr) minmax(0, 1fr);
        gap: clamp(var(--space-7), 7vw, var(--space-9));
        min-inline-size: 0;
        border-block-start: 1px solid var(--color-border);
        padding-block: clamp(var(--space-8), 9vw, 8rem);
    }

    .section-heading {
        align-self: start;
    }

    .section-index {
        margin-block-end: var(--space-4);
        color: var(--color-accent);
    }

    h2 {
        font-size: var(--font-size-heading);
        font-weight: var(--font-weight-bold);
        letter-spacing: var(--letter-spacing-heading);
        line-height: var(--line-height-heading);
    }

    .section-heading > p:last-child:not(.section-index) {
        max-inline-size: 30ch;
        margin-block-start: var(--space-5);
        color: var(--color-text-muted);
        font-size: 0.9375rem;
    }

    @media (max-width: 48rem) {
        .content-section {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-7);
            padding-block: var(--space-8);
        }

        .section-heading > p:last-child:not(.section-index) {
            max-inline-size: 36ch;
        }
    }
</style>
