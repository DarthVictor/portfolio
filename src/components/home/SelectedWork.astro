---
import { selectedWork } from "../../data/homepage";
import { getVisibleWorkEntries } from "../../lib/work-content";
import { getWorkHref } from "../../lib/work-entries";
import WorkCard from "../work/WorkCard.astro";
import HomeSection from "./HomeSection.astro";

const visibleEntries = new Map(
    (await getVisibleWorkEntries()).map((entry) => [entry.id, entry]),
);

const workItems = selectedWork.map((work) => ({
    ...work,
    caseStudies: work.caseStudySlugs.flatMap((slug) => {
        const entry = visibleEntries.get(slug);

        return entry
            ? [{ href: getWorkHref(entry.id), label: entry.data.title }]
            : [];
    }),
}));
---

<HomeSection
    index="01"
    headingId="selected-work-heading"
    title="Selected work"
    description="Product work spanning AI, platform performance, payments, and commerce."
>
    <ol class="work-list">
        {
            workItems.map((work, index) => (
                <WorkCard
                    {...work}
                    number={String(index + 1).padStart(2, "0")}
                />
            ))
        }
    </ol>
</HomeSection>

<style>
    .work-list {
        display: grid;
        gap: var(--space-4);
        list-style: none;
    }
</style>
