---
import "../../styles/palette-dev-dark.css";

interface Props {
    active:
        | "paper"
        | "atlantic"
        | "linen"
        | "lilac"
        | "paper-terracotta";
}

const { active } = Astro.props;
---

<aside
    class="theme-comparison"
    aria-label="Compare themes and choose appearance"
>
    <div class="comparison-inner">
        <p>Theme preview</p>
        <div class="theme-controls">
            <fieldset class="theme-options">
                <legend class="visually-hidden">Color palette</legend>
                <a
                    class="theme-option"
                    href="/theme-a/"
                    aria-current={active === "paper" ? "page" : undefined}
                >
                    <span class="swatch swatch-paper" aria-hidden="true"></span>
                    <span>
                        <strong>Paper</strong>
                        <small>Cobalt</small>
                    </span>
                </a>
                <a
                    class="theme-option"
                    href="/theme-b/"
                    aria-current={active === "atlantic" ? "page" : undefined}
                >
                    <span
                        class="swatch swatch-atlantic"
                        aria-hidden="true"
                    ></span>
                    <span>
                        <strong>Atlantic</strong>
                        <small>Terracotta</small>
                    </span>
                </a>
                <a
                    class="theme-option"
                    href="/theme-c/"
                    aria-current={active === "linen" ? "page" : undefined}
                >
                    <span class="swatch swatch-linen" aria-hidden="true"></span>
                    <span>
                        <strong>Linen</strong>
                        <small>Forest</small>
                    </span>
                </a>
                <a
                    class="theme-option"
                    href="/theme-d/"
                    aria-current={active === "lilac" ? "page" : undefined}
                >
                    <span class="swatch swatch-lilac" aria-hidden="true"></span>
                    <span>
                        <strong>Lilac</strong>
                        <small>Aubergine</small>
                    </span>
                </a>
                <a
                    class="theme-option"
                    href="/"
                    aria-current={
                        active === "paper-terracotta" ? "page" : undefined
                    }
                >
                    <span
                        class="swatch swatch-paper-terracotta"
                        aria-hidden="true"
                    ></span>
                    <span>
                        <strong>Paper</strong>
                        <small>Terracotta</small>
                    </span>
                </a>
            </fieldset>
            <fieldset class="appearance-options">
                <legend class="visually-hidden">Appearance</legend>
                <button
                    class="appearance-option"
                    type="button"
                    data-mode-option="light"
                    aria-pressed="false"
                >
                    <span aria-hidden="true">☼</span>
                    Light
                </button>
                <button
                    class="appearance-option"
                    type="button"
                    data-mode-option="dark"
                    aria-pressed="false"
                >
                    <span aria-hidden="true">◐</span>
                    Dark
                </button>
            </fieldset>
        </div>
    </div>
</aside>

<script is:inline>
    (() => {
        const root = document.documentElement;
        const storageKey = "portfolio-color-mode";
        const options = document.querySelectorAll("[data-mode-option]");

        const applyMode = (mode) => {
            root.dataset.mode = mode;

            options.forEach((option) => {
                option.setAttribute(
                    "aria-pressed",
                    String(option.dataset.modeOption === mode),
                );
            });
        };

        applyMode(root.dataset.mode === "dark" ? "dark" : "light");

        options.forEach((option) => {
            option.addEventListener("click", () => {
                const mode = option.dataset.modeOption;

                if (mode !== "light" && mode !== "dark") return;

                applyMode(mode);

                try {
                    localStorage.setItem(storageKey, mode);
                } catch {
                    // The visual preference still applies for the current page.
                }
            });
        });
    })();
</script>

<style>
    .theme-comparison {
        border-block-end: 1px solid var(--color-border);
        background: var(--color-surface);
    }

    .comparison-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        inline-size: min(100% - 2 * var(--space-5), 76rem);
        min-block-size: 3.5rem;
        margin-inline: auto;
    }

    .comparison-inner > p {
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .theme-controls,
    .theme-options {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    .theme-controls {
        gap: var(--space-4);
    }

    .theme-options,
    .appearance-options {
        min-inline-size: 0;
        margin: 0;
        padding: 0;
    }

    .theme-options {
        border: 0;
    }

    .visually-hidden {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    .theme-option {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        min-inline-size: 7.75rem;
        border: 1px solid transparent;
        border-radius: var(--radius-pill);
        padding: var(--space-1) var(--space-3);
        color: var(--color-text-muted);
        text-decoration: none;
    }

    .theme-option[aria-current="page"] {
        border-color: var(--color-border);
        background: var(--color-background);
        color: var(--color-text);
    }

    .theme-option > span:last-child {
        display: grid;
        line-height: 1.2;
    }

    .theme-option strong {
        font-size: 0.6875rem;
    }

    .theme-option small {
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: 0.5625rem;
    }

    .swatch {
        flex: 0 0 auto;
        inline-size: 0.65rem;
        block-size: 0.65rem;
        border-radius: var(--radius-pill);
    }

    .swatch-paper {
        background: #3155d8;
    }

    .swatch-atlantic {
        background: #a34124;
    }

    .swatch-linen {
        background: #2f6b4f;
    }

    .swatch-lilac {
        background: #7246a8;
    }

    .swatch-paper-terracotta {
        background: #a34124;
    }

    .appearance-options {
        display: flex;
        align-items: center;
        gap: var(--space-1);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-pill);
        padding: var(--space-1);
        background: var(--color-background);
    }

    .appearance-option {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        min-block-size: 2rem;
        border: 0;
        border-radius: var(--radius-pill);
        padding-inline: var(--space-3);
        background: transparent;
        color: var(--color-text-muted);
        font: inherit;
        font-size: 0.6875rem;
        font-weight: 700;
        cursor: pointer;
    }

    .appearance-option[aria-pressed="true"] {
        background: var(--color-surface-raised);
        box-shadow: 0 0 0 1px var(--color-border);
        color: var(--color-text);
    }

    .appearance-option span {
        font-size: 0.875rem;
        line-height: 1;
    }

    @media (max-width: 64rem) {
        .comparison-inner > p {
            display: none;
        }

        .theme-controls {
            inline-size: 100%;
            gap: var(--space-2);
        }

        .theme-option {
            min-inline-size: 6.75rem;
            padding-inline: var(--space-2);
        }
    }

    @media (max-width: 48rem) {
        .comparison-inner {
            align-items: stretch;
            inline-size: min(100% - 2 * var(--space-4), 76rem);
            min-block-size: 9.75rem;
            padding-block: var(--space-3);
        }

        .theme-controls {
            display: grid;
            flex: 1;
            gap: var(--space-2);
        }

        .appearance-options {
            inline-size: 100%;
        }

        .theme-options {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            inline-size: 100%;
        }

        .theme-option {
            flex: 1;
            min-inline-size: 0;
        }

        .theme-option:last-child {
            grid-column: 1 / -1;
        }

        .appearance-option {
            flex: 1;
        }
    }
</style>
