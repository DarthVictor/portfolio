---
import type { SelectedWorkItem } from "../../data/homepage";

type Props = SelectedWorkItem & {
    number: string;
    links: readonly {
        href: string;
        label: string;
    }[];
};

const { number, meta, title, summary, technologies, links } = Astro.props;
---

<li class="work-card">
    <div class="work-number" aria-hidden="true">{number}</div>
    <article>
        <p class="work-meta type-label">{meta}</p>
        <h3 class="type-card-title">{title}</h3>
        <p>{summary}</p>
        {
            links.length > 0 && (
                <ul class="card-links" aria-label="Project links">
                    {links.map(({ href, label }) => (
                        <li>
                            <a href={href}>
                                {label}
                                <span aria-hidden="true">↗</span>
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
        <ul class="tag-list" aria-label="Technologies">
            {technologies.map((technology) => <li>{technology}</li>)}
        </ul>
    </article>
</li>

<style>
    .work-card {
        display: grid;
        grid-template-columns: 4.5rem minmax(0, 1fr);
        gap: var(--space-5);
        min-inline-size: 0;
        border: var(--card-border);
        border-radius: var(--card-radius);
        background: var(--color-surface);
        padding: var(--card-padding);
        box-shadow: var(--shadow-card);
    }

    .work-number {
        color: var(--color-accent);
        font-family: var(--font-mono);
        font-size: 1.25rem;
    }

    .work-meta {
        color: var(--color-accent);
    }

    h3 {
        max-inline-size: 21ch;
        margin-block-start: var(--space-4);
    }

    article > p:not(.work-meta) {
        max-inline-size: 58ch;
        margin-block-start: var(--space-5);
        color: var(--color-text-muted);
    }

    .card-links {
        display: grid;
        gap: var(--space-2);
        margin-block-start: var(--space-6);
        list-style: none;
    }

    .card-links a {
        display: inline-flex;
        align-items: center;
        min-block-size: 2.75rem;
        gap: var(--space-2);
        color: var(--color-accent);
        font-weight: var(--font-weight-semibold);
    }

    .card-links span {
        font-family: var(--font-mono);
        font-size: var(--font-size-small);
    }

    .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-block-start: var(--space-5);
        list-style: none;
    }

    .tag-list li {
        border: 1px solid var(--color-border);
        border-radius: var(--radius-pill);
        background: var(--color-surface-raised);
        padding: var(--space-1) var(--space-3);
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: var(--font-size-micro);
    }

    @media (max-width: 48rem) {
        .work-card {
            grid-template-columns: minmax(0, 1fr);
        }

        h3 {
            max-inline-size: 16ch;
        }
    }
</style>
