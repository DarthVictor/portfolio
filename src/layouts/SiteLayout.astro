---
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import { profileLinks, siteIdentity } from "../data/site";
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    noindex?: boolean;
    openGraphType?: "article" | "website";
    publishedTime?: Date;
    modifiedTime?: Date;
    socialImage?: {
        url: string;
        alt: string;
        width: number;
        height: number;
    };
    structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
    title,
    description,
    noindex = false,
    openGraphType = "website",
    publishedTime,
    modifiedTime,
    socialImage,
    structuredData: pageStructuredData,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const defaultSocialImage = {
    url: new URL("/images/social-preview.jpg", Astro.site).href,
    alt: siteIdentity.socialImageAlt,
    width: 1200,
    height: 630,
};
const activeSocialImage = socialImage ?? defaultSocialImage;
const personId = new URL("/#victor-follet", Astro.site).href;
const homepageUrl = new URL("/", Astro.site).href;
const homepageStructuredData =
    Astro.url.pathname === "/"
        ? [
              {
                  "@context": "https://schema.org",
                  "@type": "Person",
                  "@id": personId,
                  name: siteIdentity.name,
                  alternateName: "DarthVictor",
                  description: siteIdentity.description,
                  url: homepageUrl,
                  jobTitle: siteIdentity.role,
                  knowsAbout: [
                      "React",
                      "TypeScript",
                      "Product engineering",
                      "API design",
                      "Cloud infrastructure",
                  ],
                  sameAs: [
                      profileLinks.linkedin,
                      profileLinks.github,
                      profileLinks.medium,
                  ],
              },
              {
                  "@context": "https://schema.org",
                  "@type": "ProfilePage",
                  "@id": new URL("/#profile", Astro.site).href,
                  mainEntity: { "@id": personId },
                  url: homepageUrl,
              },
              {
                  "@context": "https://schema.org",
                  "@type": "WebSite",
                  "@id": new URL("/#website", Astro.site).href,
                  name: siteIdentity.name,
                  url: homepageUrl,
              },
          ]
        : [];
const structuredData = [
    ...homepageStructuredData,
    ...(pageStructuredData === undefined
        ? []
        : Array.isArray(pageStructuredData)
          ? pageStructuredData
          : [pageStructuredData]),
];
const jsonLd = JSON.stringify(structuredData).replaceAll("<", "\\u003c");
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="sitemap" href="/sitemap.xml" />
        <meta property="og:type" content={openGraphType} />
        <meta property="og:site_name" content={siteIdentity.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={activeSocialImage.url} />
        <meta property="og:image:width" content={String(activeSocialImage.width)} />
        <meta property="og:image:height" content={String(activeSocialImage.height)} />
        <meta property="og:image:alt" content={activeSocialImage.alt} />
        {
            openGraphType === "article" && publishedTime !== undefined && (
                <meta
                    property="article:published_time"
                    content={publishedTime.toISOString()}
                />
            )
        }
        {
            openGraphType === "article" && modifiedTime !== undefined && (
                <meta
                    property="article:modified_time"
                    content={modifiedTime.toISOString()}
                />
            )
        }
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={activeSocialImage.url} />
        <meta name="twitter:image:alt" content={activeSocialImage.alt} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        {
            structuredData.length > 0 && (
                <script type="application/ld+json" set:html={jsonLd} />
            )
        }
        <title>{title}</title>
    </head>
    <body id="top">
        <SiteHeader />
        <main class="site-container">
            <slot />
        </main>
        <SiteFooter />
    </body>
</html>
