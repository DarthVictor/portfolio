---
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    palette?:
        | "paper"
        | "atlantic"
        | "linen"
        | "lilac"
        | "paper-terracotta";
    noIndex?: boolean;
}

const {
    title,
    description,
    palette = "paper-terracotta",
    noIndex = false,
} = Astro.props;
const showThemeControls = import.meta.env.DEV;
const ThemeComparison = showThemeControls
    ? (await import("../components/site/ThemeComparison.astro")).default
    : null;
---

<html lang="en" data-palette={palette}>
    <head>
        <meta charset="utf-8" />
        {
            showThemeControls && (
                <script is:inline>
                    {`
                        (() => {
                            const storageKey = "portfolio-color-mode";
                            let mode = null;

                            try {
                                mode = localStorage.getItem(storageKey);
                            } catch {
                                mode = null;
                            }

                            if (mode !== "light" && mode !== "dark") {
                                mode = matchMedia("(prefers-color-scheme: dark)").matches
                                    ? "dark"
                                    : "light";
                            }

                            document.documentElement.dataset.mode = mode;
                        })();
                    `}
                </script>
            )
        }
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        {noIndex && <meta name="robots" content="noindex" />}
        <title>{title}</title>
    </head>
    <body>
        {
            ThemeComparison && (
                <ThemeComparison active={palette} />
            )
        }
        <SiteHeader />
        <main>
            <slot />
        </main>
        <SiteFooter />
    </body>
</html>

<style>
    main {
        inline-size: min(100% - 2 * var(--space-5), 76rem);
        margin-inline: auto;
    }

    @media (max-width: 48rem) {
        main {
            inline-size: min(100% - 2 * var(--space-4), 76rem);
        }
    }
</style>
