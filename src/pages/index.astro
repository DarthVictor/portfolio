---
import "../styles/global.css";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Victor Follet is a senior frontend and full-stack engineer building dependable product experiences."
        />
        <title>Victor Follet — Senior Product Engineer</title>
    </head>
    <body>
        <header class="site-header">
            <div class="header-inner">
                <a class="brand" href="#introduction-heading" aria-label="Back to top">
                    VF<span class="brand-dot" aria-hidden="true">.</span>
                </a>
                <nav aria-label="Primary navigation">
                    <a href="#selected-work-heading">Work</a>
                    <a href="#experience-heading">Experience</a>
                    <a class="nav-about" href="#about-heading">About</a>
                    <a class="nav-contact" href="#contact-heading">Contact</a>
                </nav>
            </div>
        </header>

        <main>
            <section
                class="hero"
                aria-labelledby="introduction-heading"
            >
                <div class="hero-topline">
                    <p class="eyebrow">Senior frontend + full-stack engineer</p>
                    <p class="current-role">
                        <span aria-hidden="true"></span>
                        Currently at Tolstoy
                    </p>
                </div>

                <h1 id="introduction-heading">
                    Victor Follet,{" "}
                    <span class="role-line">senior product engineer</span>
                </h1>

                <div class="hero-details">
                    <p class="hero-statement">
                        I build dependable product experiences across frontend
                        and full-stack systems.
                    </p>
                    <div class="hero-summary">
                        <p>
                            For more than 12 years, I have worked on SaaS,
                            fintech, e-commerce, and AI-enabled products, with a
                            focus on frontend quality, maintainable architecture,
                            and delivery.
                        </p>
                        <div class="hero-actions">
                            <a class="button button-primary" href="mailto:follet.victor@gmail.com">
                                Start a conversation
                                <span aria-hidden="true">↗</span>
                            </a>
                            <a class="button button-secondary" href="/cv.pdf">
                                Download CV
                                <span aria-hidden="true">↓</span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <section class="content-section" aria-labelledby="selected-work-heading">
                <div class="section-heading">
                    <p class="section-index">01</p>
                    <h2 id="selected-work-heading">Selected work</h2>
                    <p>
                        Product work spanning AI, platform performance, payments,
                        and commerce.
                    </p>
                </div>

                <ol class="work-list">
                    <li class="work-card">
                        <div class="work-number" aria-hidden="true">01</div>
                        <article>
                            <p class="work-meta">Tolstoy · AI + Design systems</p>
                            <h3>AI integrations built on reusable UI foundations</h3>
                            <p>
                                Building AI-agent capabilities for third-party
                                integrations alongside reusable React and
                                TypeScript UI infrastructure.
                            </p>
                            <ul class="tag-list" aria-label="Technologies">
                                <li>React</li>
                                <li>TypeScript</li>
                                <li>AI integrations</li>
                            </ul>
                        </article>
                    </li>
                    <li class="work-card">
                        <div class="work-number" aria-hidden="true">02</div>
                        <article>
                            <p class="work-meta">Bright Data · SaaS platform</p>
                            <h3>Faster product workflows and resilient payments</h3>
                            <p>
                                Improving frontend performance on a proxy-management
                                platform and building payment flows across React
                                and Node.js services.
                            </p>
                            <ul class="tag-list" aria-label="Technologies">
                                <li>React</li>
                                <li>Node.js</li>
                                <li>Payments</li>
                            </ul>
                        </article>
                    </li>
                    <li class="work-card">
                        <div class="work-number" aria-hidden="true">03</div>
                        <article>
                            <p class="work-meta">Tenengroup · E-commerce</p>
                            <h3>Checkout experiences backed by scalable data access</h3>
                            <p>
                                Creating shopping-cart experiences and a scalable
                                Next.js data-access and API layer for e-commerce
                                products.
                            </p>
                            <ul class="tag-list" aria-label="Technologies">
                                <li>Next.js</li>
                                <li>APIs</li>
                                <li>E-commerce</li>
                            </ul>
                        </article>
                    </li>
                </ol>
            </section>

            <section class="content-section" aria-labelledby="experience-heading">
                <div class="section-heading">
                    <p class="section-index">02</p>
                    <h2 id="experience-heading">Experience</h2>
                    <p>
                        More than a decade building product teams and systems
                        across varied domains.
                    </p>
                </div>

                <ol class="experience-list">
                    <li>
                        <article>
                            <div>
                                <p class="company">Tolstoy</p>
                                <h3>Senior Full Stack Engineer</h3>
                            </div>
                            <p class="period">
                                <time datetime="2024-11">Nov 2024</time>
                                <span>— Present</span>
                            </p>
                        </article>
                    </li>
                    <li>
                        <article>
                            <div>
                                <p class="company">Bright Data</p>
                                <h3>Senior Full Stack Developer</h3>
                            </div>
                            <p class="period">
                                <time datetime="2024-02">Feb 2024</time>
                                <span>—</span>
                                <time datetime="2024-11">Nov 2024</time>
                            </p>
                        </article>
                    </li>
                    <li>
                        <article>
                            <div>
                                <p class="company">Tenengroup</p>
                                <h3>Senior Full Stack Developer</h3>
                            </div>
                            <p class="period">
                                <time datetime="2022-07">Jul 2022</time>
                                <span>—</span>
                                <time datetime="2024-02">Feb 2024</time>
                            </p>
                        </article>
                    </li>
                    <li>
                        <article>
                            <div>
                                <p class="company">Luxoft</p>
                                <h3>Chief Frontend Developer</h3>
                            </div>
                            <p class="period">
                                <time datetime="2021-02">Feb 2021</time>
                                <span>—</span>
                                <time datetime="2022-07">Jul 2022</time>
                            </p>
                        </article>
                    </li>
                    <li>
                        <article>
                            <div>
                                <p class="company">Earlier experience</p>
                                <h3>Product and platform engineering</h3>
                                <p class="company-list">
                                    Mail.Ru Group, Yandex, Idea Platform,
                                    Systematica, and Allied Testing
                                </p>
                            </div>
                            <p class="period">
                                <time datetime="2010">2010</time>
                                <span>—</span>
                                <time datetime="2021">2021</time>
                            </p>
                        </article>
                    </li>
                </ol>
            </section>

            <section class="content-section" aria-labelledby="capabilities-heading">
                <div class="section-heading">
                    <p class="section-index">03</p>
                    <h2 id="capabilities-heading">Capabilities</h2>
                    <p>
                        Product judgment and engineering depth from interface to
                        infrastructure.
                    </p>
                </div>

                <ul class="capability-list">
                    <li class="capability-featured">
                        <p class="capability-label">Interface</p>
                        <h3>Frontend systems</h3>
                        <p>
                            React, Next.js, TypeScript, JavaScript, design
                            systems, and frontend architecture.
                        </p>
                        <p class="capability-mark" aria-hidden="true">Aa</p>
                    </li>
                    <li>
                        <p class="capability-label">Product</p>
                        <h3>Platform delivery</h3>
                        <p>
                            Node.js, Express, REST APIs, PostgreSQL, MongoDB,
                            and DynamoDB.
                        </p>
                        <p class="capability-mark code-mark" aria-hidden="true">&lt;/&gt;</p>
                    </li>
                    <li>
                        <p class="capability-label">Operations</p>
                        <h3>Cloud and delivery</h3>
                        <p>
                            AWS, Lambda, Docker, Kubernetes, CI/CD, and
                            integration automation.
                        </p>
                        <p class="capability-mark" aria-hidden="true">↗</p>
                    </li>
                </ul>
            </section>

            <section class="content-section about-section" aria-labelledby="about-heading">
                <div class="section-heading">
                    <p class="section-index">04</p>
                    <h2 id="about-heading">How I work</h2>
                </div>

                <div class="about-copy">
                    <p class="about-lead">
                        Clear interfaces come from clear engineering decisions.
                    </p>
                    <p>
                        I specialize in the product-facing details that make
                        software clear, fast, and maintainable. I am comfortable
                        working across the stack while keeping the user experience
                        and the engineering foundations aligned.
                    </p>
                    <ul class="principles">
                        <li><span>01</span> Start with the user and the constraint</li>
                        <li><span>02</span> Make tradeoffs explicit</li>
                        <li><span>03</span> Build systems teams can extend</li>
                    </ul>
                </div>
            </section>

            <section class="contact-section" aria-labelledby="contact-heading">
                <div>
                    <p class="contact-kicker">Have an interesting product problem?</p>
                    <h2 id="contact-heading">Contact</h2>
                    <p class="contact-lead">Let’s build something dependable.</p>
                </div>
                <div class="contact-actions">
                    <a class="contact-email" href="mailto:follet.victor@gmail.com">
                        follet.victor@gmail.com
                        <span aria-hidden="true">↗</span>
                    </a>
                    <ul class="contact-list">
                        <li>
                            <a href="https://www.linkedin.com/in/victor-follet/">
                                LinkedIn <span aria-hidden="true">↗</span>
                            </a>
                        </li>
                        <li>
                            <a href="https://github.com/DarthVictor">
                                GitHub <span aria-hidden="true">↗</span>
                            </a>
                        </li>
                        <li>
                            <a href="/cv.pdf">
                                Download CV <span aria-hidden="true">↓</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </section>
        </main>

        <footer>
            <p>Victor Follet · Senior product engineer</p>
            <a href="#introduction-heading">Back to top ↑</a>
        </footer>
    </body>
</html>

<style>
    .site-header {
        position: relative;
        z-index: 10;
        border-block-end: 1px solid var(--color-border);
    }

    .header-inner,
    main,
    footer {
        inline-size: min(100% - 2 * var(--space-5), 76rem);
        margin-inline: auto;
    }

    .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-block-size: 5rem;
    }

    .brand {
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.06em;
        text-decoration: none;
    }

    .brand-dot {
        color: var(--color-accent);
    }

    nav {
        display: flex;
        align-items: center;
        gap: clamp(var(--space-4), 3vw, var(--space-6));
    }

    nav a {
        color: var(--color-text-muted);
        font-size: var(--font-size-small);
        font-weight: 650;
        text-decoration: none;
    }

    nav a:hover {
        color: var(--color-text);
    }

    .nav-contact {
        border: 1px solid var(--color-border);
        border-radius: var(--radius-pill);
        color: var(--color-text);
        padding: var(--space-2) var(--space-4);
    }

    .hero {
        min-inline-size: 0;
        padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    }

    .hero-topline,
    .hero-details {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
        gap: var(--space-7);
    }

    .hero-topline {
        align-items: center;
        margin-block-end: clamp(var(--space-6), 5vw, var(--space-8));
    }

    .eyebrow,
    .current-role,
    .section-index,
    .work-meta,
    .company,
    .capability-label,
    .contact-kicker {
        font-family: var(--font-mono);
        font-size: var(--font-size-small);
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .eyebrow {
        color: var(--color-accent);
    }

    .current-role {
        display: flex;
        align-items: center;
        justify-self: end;
        color: var(--color-text-muted);
    }

    .current-role span {
        inline-size: 0.55rem;
        block-size: 0.55rem;
        margin-inline-end: var(--space-2);
        border-radius: var(--radius-pill);
        background: var(--color-status);
        box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--color-status) 14%, transparent);
    }

    h1 {
        max-inline-size: 11ch;
        font-size: var(--font-size-display);
        font-weight: 760;
        letter-spacing: -0.075em;
        line-height: var(--line-height-display);
    }

    .role-line {
        display: block;
        color: var(--color-text-muted);
        font-weight: 520;
    }

    .hero-details {
        align-items: start;
        margin-block-start: clamp(var(--space-7), 7vw, var(--space-9));
    }

    .hero-statement {
        max-inline-size: 24ch;
        font-size: clamp(1.5rem, 2.7vw, 2.5rem);
        font-weight: 620;
        letter-spacing: -0.045em;
        line-height: 1.12;
    }

    .hero-summary {
        display: grid;
        gap: var(--space-6);
        color: var(--color-text-muted);
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        min-block-size: 3.25rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-pill);
        padding: var(--space-3) var(--space-5);
        font-size: var(--font-size-small);
        font-weight: 750;
        text-decoration: none;
        transition:
            background var(--motion-fast) var(--easing-standard),
            border-color var(--motion-fast) var(--easing-standard),
            color var(--motion-fast) var(--easing-standard);
    }

    .button-primary {
        border-color: var(--color-text);
        background: var(--color-panel);
        color: var(--color-panel-text);
    }

    .button-primary:hover {
        border-color: var(--color-accent);
        background: var(--color-accent);
        color: var(--color-text-inverse);
    }

    .button-secondary:hover {
        border-color: var(--color-text);
        background: var(--color-surface);
    }

    .content-section {
        display: grid;
        grid-template-columns: minmax(11rem, 0.38fr) minmax(0, 1fr);
        gap: clamp(var(--space-7), 7vw, var(--space-9));
        min-inline-size: 0;
        border-block-start: 1px solid var(--color-border);
        padding-block: clamp(var(--space-8), 9vw, 8rem);
    }

    .section-heading {
        align-self: start;
    }

    .section-index {
        margin-block-end: var(--space-4);
        color: var(--color-accent);
    }

    h2 {
        font-size: var(--font-size-heading);
        font-weight: 720;
        letter-spacing: -0.055em;
        line-height: var(--line-height-heading);
    }

    .section-heading > p:last-child {
        max-inline-size: 30ch;
        margin-block-start: var(--space-5);
        color: var(--color-text-muted);
        font-size: 0.9375rem;
    }

    .work-list,
    .experience-list,
    .capability-list,
    .principles,
    .contact-list {
        list-style: none;
    }

    .work-list {
        display: grid;
        gap: var(--space-4);
    }

    .work-card {
        display: grid;
        grid-template-columns: 4.5rem minmax(0, 1fr);
        gap: var(--space-5);
        min-inline-size: 0;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-medium);
        background: var(--color-surface);
        padding: clamp(var(--space-5), 4vw, var(--space-7));
        box-shadow: var(--shadow-card);
    }

    .work-number {
        color: var(--color-accent);
        font-family: var(--font-mono);
        font-size: 1.25rem;
    }

    .work-meta,
    .company,
    .capability-label {
        color: var(--color-accent);
    }

    .work-card h3 {
        max-inline-size: 21ch;
        margin-block-start: var(--space-4);
        font-size: clamp(1.5rem, 3vw, 2.35rem);
        font-weight: 680;
        letter-spacing: -0.045em;
        line-height: 1.08;
    }

    .work-card article > p:not(.work-meta) {
        max-inline-size: 58ch;
        margin-block-start: var(--space-5);
        color: var(--color-text-muted);
    }

    .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-block-start: var(--space-6);
        list-style: none;
    }

    .tag-list li {
        border: 1px solid var(--color-border);
        border-radius: var(--radius-pill);
        background: var(--color-surface-raised);
        padding: var(--space-1) var(--space-3);
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
    }

    .experience-list {
        border-block-start: 1px solid var(--color-border);
    }

    .experience-list li {
        border-block-end: 1px solid var(--color-border);
    }

    .experience-list article {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: var(--space-5);
        align-items: start;
        padding-block: var(--space-6);
    }

    .experience-list h3 {
        margin-block-start: var(--space-2);
        font-size: clamp(1.15rem, 2vw, 1.5rem);
        font-weight: 660;
        letter-spacing: -0.03em;
        line-height: 1.2;
    }

    .company-list {
        max-inline-size: 48ch;
        margin-block-start: var(--space-3);
        color: var(--color-text-muted);
        font-size: 0.875rem;
    }

    .period {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        justify-content: flex-end;
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: var(--font-size-small);
        white-space: nowrap;
    }

    .capability-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-4);
    }

    .capability-list li {
        position: relative;
        min-block-size: 20rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-medium);
        background: var(--color-surface);
        padding: clamp(var(--space-5), 4vw, var(--space-7));
        overflow: hidden;
    }

    .capability-list .capability-featured {
        grid-column: 1 / -1;
        min-block-size: 17rem;
        background: var(--color-accent-soft);
    }

    .capability-list h3 {
        max-inline-size: 12ch;
        margin-block-start: var(--space-4);
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 680;
        letter-spacing: -0.045em;
        line-height: 1.08;
    }

    .capability-list li > p:not(.capability-label, .capability-mark) {
        position: relative;
        z-index: 1;
        max-inline-size: 34ch;
        margin-block-start: var(--space-5);
        color: var(--color-text-muted);
    }

    .capability-mark {
        position: absolute;
        inset-inline-end: var(--space-5);
        inset-block-end: calc(var(--space-6) * -1);
        color: color-mix(in srgb, var(--color-accent) 16%, transparent);
        font-size: 9rem;
        font-weight: 800;
        letter-spacing: -0.1em;
        line-height: 1;
        user-select: none;
    }

    .code-mark {
        font-family: var(--font-mono);
        font-size: 6rem;
    }

    .about-copy {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.65fr);
        gap: var(--space-7);
    }

    .about-lead {
        grid-column: 1 / -1;
        max-inline-size: 24ch;
        font-size: clamp(2rem, 4vw, 3.5rem);
        font-weight: 620;
        letter-spacing: -0.055em;
        line-height: 1.08;
    }

    .about-copy > p:not(.about-lead) {
        max-inline-size: 52ch;
        color: var(--color-text-muted);
    }

    .principles {
        display: grid;
        gap: var(--space-3);
    }

    .principles li {
        display: grid;
        grid-template-columns: 2rem minmax(0, 1fr);
        gap: var(--space-3);
        border-block-start: 1px solid var(--color-border);
        padding-block-start: var(--space-3);
        font-size: 0.875rem;
        font-weight: 650;
    }

    .principles span {
        color: var(--color-accent);
        font-family: var(--font-mono);
        font-size: 0.75rem;
    }

    .contact-section {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
        gap: var(--space-7);
        border-radius: var(--radius-large);
        background: var(--color-text);
        color: var(--color-text-inverse);
        padding: clamp(var(--space-6), 7vw, var(--space-9));
    }

    .contact-kicker {
        margin-block-end: var(--space-5);
        color: var(--color-panel-accent);
    }

    .contact-section h2 {
        font-size: 1rem;
        letter-spacing: 0;
    }

    .contact-lead {
        max-inline-size: 10ch;
        margin-block-start: var(--space-5);
        font-size: clamp(2.5rem, 6vw, 5rem);
        font-weight: 680;
        letter-spacing: -0.065em;
        line-height: 0.98;
    }

    .contact-actions {
        display: grid;
        align-content: end;
        gap: var(--space-6);
        min-inline-size: 0;
    }

    .contact-email {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        border-block-end: 1px solid currentColor;
        padding-block-end: var(--space-3);
        font-size: clamp(1rem, 2vw, 1.35rem);
        font-weight: 620;
        text-decoration: none;
    }

    .contact-list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }

    .contact-list a {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
        border-radius: var(--radius-pill);
        padding: var(--space-2) var(--space-4);
        font-size: var(--font-size-small);
        text-decoration: none;
    }

    .contact-list a:hover {
        border-color: var(--color-accent);
        background: var(--color-accent);
    }

    footer {
        display: flex;
