---
import ArchiveWorkCard from "../../components/work/ArchiveWorkCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getVisibleWorkEntries } from "../../lib/work-content";

const entries = await getVisibleWorkEntries();
const workUrl = new URL("/work/", Astro.site).href;
const workStructuredData = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: new URL("/", Astro.site).href,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Work",
            item: workUrl,
        },
    ],
};
---

<SiteLayout
    title="Work — Victor Follet"
    description="Case studies about product engineering, system design, and technical leadership by Victor Follet."
    structuredData={workStructuredData}
>
    <section class="work-archive" aria-labelledby="work-heading">
        <header class="archive-header">
            <p class="type-label">Selected case studies</p>
            <h1 id="work-heading">Work</h1>
            <p class="introduction">
                Product engineering case studies focused on decisions,
                constraints, and outcomes.
            </p>
        </header>

        {
            entries.length > 0 ? (
                <ol class="work-list">
                    {entries.map((entry, index) => (
                        <ArchiveWorkCard
                            entry={entry}
                            number={String(index + 1).padStart(2, "0")}
                        />
                    ))}
                </ol>
            ) : (
                <div class="empty-state">
                    <p class="type-label">Archive in progress</p>
                    <h2>Case studies are being prepared</h2>
                    <p>
                        This archive is intentionally empty while the first case
                        studies are reviewed for accuracy and confidentiality.
                    </p>
                    <a href="/#selected-work-heading">View selected work summary</a>
                </div>
            )
        }
    </section>
</SiteLayout>

<style>
    .work-archive {
        padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    }

    .archive-header {
        max-inline-size: 52rem;
    }

    .archive-header .type-label {
        color: var(--color-accent);
    }

    h1 {
        margin-block-start: var(--space-4);
        font-size: var(--font-size-display);
        letter-spacing: var(--letter-spacing-display);
        line-height: var(--line-height-display);
    }

    .introduction {
        max-inline-size: 56ch;
        margin-block-start: var(--space-6);
        color: var(--color-text-muted);
        font-size: clamp(1.125rem, 2vw, 1.35rem);
    }

    .work-list {
        display: grid;
        gap: var(--space-5);
        margin-block-start: var(--space-8);
        list-style: none;
    }

    .empty-state {
        max-inline-size: 48rem;
        margin-block-start: var(--space-8);
        border: var(--card-border);
        border-radius: var(--card-radius);
        background: var(--color-surface);
        padding: var(--card-padding);
        box-shadow: var(--shadow-card);
    }

    .empty-state .type-label {
        color: var(--color-accent);
    }

    .empty-state h2 {
        margin-block-start: var(--space-4);
        font-size: var(--font-size-heading);
        letter-spacing: var(--letter-spacing-heading);
        line-height: var(--line-height-heading);
    }

    .empty-state p:not(.type-label) {
        max-inline-size: 58ch;
        margin-block-start: var(--space-5);
        color: var(--color-text-muted);
    }

    .empty-state a {
        display: inline-flex;
        align-items: center;
        min-block-size: 2.75rem;
        margin-block-start: var(--space-6);
        color: var(--color-accent);
        font-weight: var(--font-weight-semibold);
    }
</style>
